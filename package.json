{
  "name": "opencode-context-manager",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": { "opencode": "2.0.24", "node": ">=22" },
  "exports": { ".": "./src/server.ts", "./server": "./src/server.ts", "./tui": "./src/tui.tsx", "./rpc": "./src/rpc.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:tui": "node script/test-tui.mjs",
    "check": "npm run typecheck && npm test && npm run test:tui",
    "test:host": "tsx script/host-smoke.ts",
    "typecheck:v2-host": "tsc --noEmit -p test/v2-host/tsconfig.json",
    "test:v2-host": "npm run typecheck:v2-host && node script/v2-host-smoke.mjs"
  },
  "peerDependencies": {
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "solid-js": "1.9.15"
  },
  "dependencies": {
    "gpt-tokenizer": "4.0.0",
    "@opencode/ai": "2.0.24",
    "@opencode/client": "2.0.24",
    "@opencode/plugin": "2.0.24",
    "zod": "4.1.8"
  },
  "overrides": {
    "@opentui/solid": { "solid-js": "$solid-js" },
    "seroval": "1.6.8"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.24",
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14",
    "@types/node": "^24.0.0",
    "bun": "1.4.2",
    "solid-js": "1.9.15",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3"
  }
}
